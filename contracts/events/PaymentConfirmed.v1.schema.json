{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.shopeasy.example/events/PaymentConfirmed.v1.schema.json",
  "title": "PaymentConfirmed v1",
  "allOf": [
    {"$ref": "event-envelope.schema.json"},
    {
      "type": "object",
      "properties": {
        "eventType": {"const": "PaymentConfirmed"},
        "producer": {"const": "payments"},
        "data": {
          "type": "object",
          "required": ["paymentId", "orderId", "amount"],
          "properties": {
            "paymentId": {"type": "string", "format": "uuid"},
            "orderId": {"type": "string", "format": "uuid"},
            "amount": {"$ref": "#/$defs/money"},
            "providerReference": {"type": "string", "minLength": 1, "maxLength": 200}
          },
          "additionalProperties": true
        }
      }
    }
  ],
  "$defs": {
    "money": {
      "type": "object",
      "required": ["amount", "currency"],
      "properties": {
        "amount": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,4})?$"},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}
      },
      "additionalProperties": true
    }
  }
}
