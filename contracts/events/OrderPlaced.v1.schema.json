{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.shopeasy.example/events/OrderPlaced.v1.schema.json",
  "title": "OrderPlaced v1",
  "allOf": [
    {"$ref": "event-envelope.schema.json"},
    {
      "type": "object",
      "properties": {
        "eventType": {"const": "OrderPlaced"},
        "producer": {"const": "orders"},
        "data": {
          "type": "object",
          "required": ["orderId", "total", "items"],
          "properties": {
            "orderId": {"type": "string", "format": "uuid"},
            "total": {"$ref": "#/$defs/money"},
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["productId", "name", "quantity", "unitPrice"],
                "properties": {
                  "productId": {"type": "string", "format": "uuid"},
                  "name": {"type": "string", "minLength": 1},
                  "quantity": {"type": "integer", "minimum": 1},
                  "unitPrice": {"$ref": "#/$defs/money"}
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": true
        }
      }
    }
  ],
  "$defs": {
    "money": {
      "type": "object",
      "required": ["amount", "currency"],
      "properties": {
        "amount": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,4})?$"},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}
      },
      "additionalProperties": true
    }
  }
}
