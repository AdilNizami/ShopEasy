{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.shopeasy.example/events/OrderDelivered.v1.schema.json",
  "title": "OrderDelivered v1",
  "allOf": [
    {"$ref": "event-envelope.schema.json"},
    {
      "type": "object",
      "properties": {
        "eventType": {"const": "OrderDelivered"},
        "producer": {"const": "shipping"},
        "data": {
          "type": "object",
          "required": ["orderId", "shipmentId", "deliveredAt"],
          "properties": {
            "orderId": {"type": "string", "format": "uuid"},
            "shipmentId": {"type": "string", "format": "uuid"},
            "deliveredAt": {"type": "string", "format": "date-time"},
            "recipient": {"type": "string", "maxLength": 200}
          },
          "additionalProperties": true
        }
      }
    }
  ]
}
